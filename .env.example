# Clay Automation Hub — Environment Variables
# Copy this file to .env and fill in your credentials.

# ── Clay ──
CLAY_API_KEY=
CLAY_WORKSPACE_ID=

# ── Dealcloud ──
DEALCLOUD_API_KEY=
DEALCLOUD_BASE_URL=https://api.dealcloud.com/api/v1
DEALCLOUD_CLIENT_ID=
DEALCLOUD_CLIENT_SECRET=

# ── Zoom (Server-to-Server OAuth) ──
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# ── Outreach.io ──
OUTREACH_API_KEY=
OUTREACH_CLIENT_ID=
OUTREACH_CLIENT_SECRET=
OUTREACH_REDIRECT_URI=http://localhost:3000/auth/outreach/callback

# ── Gmail (Google OAuth) ──
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/auth/gmail/callback
GMAIL_REFRESH_TOKEN=

# ── Automation Settings ──
CLAY_LOG_LEVEL=info
CLAY_WEBHOOK_PORT=3000
